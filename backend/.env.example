# Copy to backend/.env and fill in the passwords (backend/.env is not committed).
# Passwords must match the ones used with scripts/db/bootstrap_roles.sql.

SOESIS_ENV=development

# Runtime role: data read/write, CREATE only in schema "ingest".
SOESIS_DATABASE_URL=postgresql+psycopg://soesis_app:CHANGE_ME_APP@db:5432/soesis

# Schema owner role, used only by Alembic.
SOESIS_MIGRATOR_DATABASE_URL=postgresql+psycopg://soesis_migrator:CHANGE_ME_MIGRATOR@db:5432/soesis

# Celery broker. DB 2 keeps it apart from Laravel's Redis keys (DB 0/1).
SOESIS_REDIS_URL=redis://redis:6379/2

# Shared with Laravel during the rewrite (api/storage/app/private), mounted in docker-compose.
SOESIS_STORAGE_ROOT=/data/storage

# Tests (pytest) run against this separate database only.
SOESIS_TEST_DATABASE_URL=postgresql+psycopg://soesis_app:CHANGE_ME_APP@db:5432/soesis_pytest
SOESIS_TEST_MIGRATOR_DATABASE_URL=postgresql+psycopg://soesis_migrator:CHANGE_ME_MIGRATOR@db:5432/soesis_pytest

# ---- Authentication (R0.5) ----
# HS256 secret, at least 32 random characters (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))").
SOESIS_JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARACTERS
SOESIS_ACCESS_TOKEN_MINUTES=15
SOESIS_REFRESH_TOKEN_DAYS=7
# true only behind HTTPS.
SOESIS_COOKIE_SECURE=false
SOESIS_RATE_LIMIT_REDIS_URL=redis://redis:6379/3
# Browser origins allowed to send POST/PATCH/DELETE (the Next.js origin; 3100 = alternative dev/test port).
SOESIS_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:3100"]
