{
  "components": {
    "schemas": {
      "ComponentResponse": {
        "properties": {
          "detail": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Detail",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "failed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "detail"
        ],
        "title": "ComponentResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LivenessResponse",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "login": {
            "description": "E-mail or username (case-insensitive)",
            "maxLength": 255,
            "minLength": 1,
            "title": "Login",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "MessageResponse": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "MessageResponse",
        "type": "object"
      },
      "OrganizationResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "OrganizationResponse",
        "type": "object"
      },
      "OrganizationWithCountResponse": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "users_count": {
            "title": "Users Count",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "users_count"
        ],
        "title": "OrganizationWithCountResponse",
        "type": "object"
      },
      "OrganizationWriteRequest": {
        "properties": {
          "name": {
            "maxLength": 255,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "OrganizationWriteRequest",
        "type": "object"
      },
      "PasswordResetRequest": {
        "properties": {
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "title": "PasswordResetRequest",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "components": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ComponentResponse"
            },
            "title": "Components",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "components"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "access_expires_at": {
            "format": "date-time",
            "title": "Access Expires At",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "required": [
          "user",
          "access_expires_at"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "UserCreateRequest": {
        "properties": {
          "email": {
            "maxLength": 255,
            "title": "Email",
            "type": "string"
          },
          "is_active": {
            "default": true,
            "title": "Is Active",
            "type": "boolean"
          },
          "name": {
            "maxLength": 100,
            "title": "Name",
            "type": "string"
          },
          "organization_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organization Id"
          },
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          },
          "role": {
            "enum": [
              "uploader",
              "curator",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "maxLength": 30,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "name",
          "username",
          "email",
          "role",
          "password"
        ],
        "title": "UserCreateRequest",
        "type": "object"
      },
      "UserResponse": {
        "description": "Never contains the password hash, remember token or any token.",
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "organization": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrganizationResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "enum": [
              "uploader",
              "curator",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "role_label": {
            "title": "Role Label",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "username",
          "email",
          "role",
          "role_label",
          "is_active",
          "organization"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "UserWriteRequest": {
        "properties": {
          "email": {
            "maxLength": 255,
            "title": "Email",
            "type": "string"
          },
          "is_active": {
            "default": true,
            "title": "Is Active",
            "type": "boolean"
          },
          "name": {
            "maxLength": 100,
            "title": "Name",
            "type": "string"
          },
          "organization_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organization Id"
          },
          "role": {
            "enum": [
              "uploader",
              "curator",
              "admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "username": {
            "maxLength": 30,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "name",
          "username",
          "email",
          "role"
        ],
        "title": "UserWriteRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SoESIS WebGIS API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
