                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OrganizationWithCountResponse"
                  },
                  "title": "Response List Organizations Api Admin Organizations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "Not signed in (or session ended)"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "Signed in without the required role"
          }
        },
        "summary": "List Organizations",
        "tags": [
          "admin"
        ]
      },
